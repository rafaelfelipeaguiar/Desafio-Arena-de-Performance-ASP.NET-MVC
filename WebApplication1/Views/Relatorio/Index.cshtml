@model WebApplication1.Models.RelatorioFiltroViewModel
@{
    ViewData["Title"] = "Relatório de Clientes";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"] - @(string.IsNullOrWhiteSpace(Model.Cidade) ? "Ji-Paraná" : Model.Cidade)</h2>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <strong>Critérios do Relatório</strong>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                
                <div class="col-md-4">
                    <label for="cidade" class="form-label">Cidade *</label>
                    <input type="text" class="form-control" id="cidade" name="cidade" value="@Model.Cidade" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Mínimo de Pedidos</label>
                    <input type="text" class="form-control" value="> 5 pedidos" disabled readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Período</label>
                    <input type="text" class="form-control" value="Últimos 90 dias" disabled readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Ordenação</label>
                    <input type="text" class="form-control" value="Valor Total (decrescente)" disabled readonly />
                </div>

                <div class="col-md-6">
                    <label for="nomeBusca" class="form-label fw-bold text-primary">Buscar por parte do nome do cliente *</label>
                    <input type="text" 
                           class="form-control border-primary" 
                           id="nomeBusca" 
                           name="nomeBusca" 
                           value="@Model.NomeBusca" 
                           placeholder="Digite parte do nome..." />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Resultados.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Nome do Cliente</th>
                        <th scope="col">Cidade</th>
                        <th scope="col" class="text-end">Valor Total Acumulado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Resultados)
                    {
                        <tr>
                            <td>@item.NomeCliente</td>
                            <td>@item.Cidade</td>
                            <td class="text-end">@item.ValorTotalAcumulado.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Nenhum cliente encontrado com os critérios informados.
        </div>
    }
</div>
